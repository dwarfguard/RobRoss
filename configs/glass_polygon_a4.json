{
  "profile_name": "glass_polygon_a4",
  "project": "R.O.B Ross",
  "style": "glass_polygon",

  "canvas": {
    "name": "A4 portrait",
    "width_mm": 210.0,
    "height_mm": 297.0,
    "margin_mm": 10.0,
    "origin": "top-left"
  },

  "source_image": {
    "path": "Image_Process/assets/sample.jpg",
    "blur_kernel_size": 5,
    "blur_sigma": 0,
    "downscale_max_dimension_px": 600
  },

  "palette": {
    "colors": [
      {"name": "white", "hex": "#ffffff"},
      {"name": "red", "hex": "#d62828"},
      {"name": "yellow", "hex": "#f1c40f"},
      {"name": "blue", "hex": "#1d3557"},
      {"name": "black", "hex": "#000000"}
    ],
    "color_space": "lab"
  },

  "color_mapping": {
    "standard_colors": {
      "white": "#ffffff",
      "red": "#ff0000",
      "yellow": "#ffff00",
      "blue": "#0000ff",
      "black": "#000000"
    },
    "region_mapping": {},
    "overlay_mapping": {},
    "drop_colors": ["black"]
  },

  "segmentation": {
    "min_region_area_mm2": 50.0,
    "morph_open_kernel_px": 5,
    "morph_close_kernel_px": 15,
    "skip_white_regions": true,
    "protect_face_features": true,
    "face_protection_margin_px": 3
  },

  "path_generation": {
    "tool_width_mm": 5.0,
    "stroke_overlap_ratio": 0.25,
    "mask_erosion_mm": 2.5,
    "home_position_mm": [10.0, 10.0]
  },

  "border_generation": {
    "draw_borders": true,
    "simplify_epsilon_ratio": 0.015
  },

  "output": {
    "directory": "output/glass_polygon_a4",
    "painting_paths_file": "glass_polygon_paths.json",
    "preview_svg_file": "glass_polygon_preview.svg",
    "quantized_preview_png_file": "glass_polygon_quantized_preview.png"
  }
}
