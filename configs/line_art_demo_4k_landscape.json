{
  "profile_name": "line_art_demo_4k_landscape",
  "project": "R.O.B Ross",
  "style": "line_art",

  "canvas": {
    "name": "4K landscape",
    "width_mm": 525.0,
    "height_mm": 375.0,
    "margin_mm": 10.0,
    "origin": "top-left"
  },

  "source_image": {
    "path": "Image_Process/assets/hinton.png",
    "binary_threshold": 200,
    "morph_close_kernel_px": 2,
    "min_spur_length_px": 4.0,
    "min_stroke_length_mm": 2.0,
    "simplify_epsilon_ratio": 0.002,
    "simplify_min_epsilon_px": 1.0
  },

  "path_generation": {
    "tool_width_mm": 1.0,
    "home_position_mm": [10.0, 10.0],
    "join_overlapping_strokes": true,
    "max_join_turn_degrees": 60.0,
    "smoothing_radius_mm": 1.2
  },

  "output": {
    "directory": "output/line_art_demo_4k_landscape",
    "painting_paths_file": "line_art_painting_paths.json",
    "preview_svg_file": "line_art_path_preview.svg"
  }
}
